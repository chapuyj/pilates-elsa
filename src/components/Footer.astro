---
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { navigation, contactHref } from '../config/navigation';
import { offresPubliees } from '../lib/offres';
import { dansLOrdre } from '../lib/listes';

const offres = await offresPubliees();
const lieux = dansLOrdre(await getCollection('lieux'));
const annee = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="columns">
      <div class="about">
        <p class="name">{site.name}</p>
        <p class="muted">{site.tagline}.</p>
        <a class="btn btn--ink" href={contactHref}>Écrire à Elsa</a>
      </div>

      <nav aria-label="Les cours">
        <h2>Cours</h2>
        <ul role="list">
          {offres.map((offre) => <li><a href={`/${offre.id}/`}>{offre.data.titreCourt}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Le site">
        <h2>Le site</h2>
        <ul role="list">
          {navigation.filter((item) => !item.href.startsWith('/#')).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={contactHref}>Contact</a></li>
        </ul>
      </nav>

      <div>
        <h2>Studios</h2>
        <ul role="list">
          {lieux.map((lieu) => (
            <li>
              <a href={lieu.data.site} rel="noopener">{lieu.data.nom}</a>
              <span class="muted">{lieu.data.ville}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="legal">
      <p>© {annee} {site.name}</p>
      <ul role="list">
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/confidentialite/">Confidentialité</a></li>
      </ul>
    </div>
  </div>

  <p class="wordmark" aria-hidden="true">{site.name}</p>
</footer>

<style>
  .site-footer {
    margin: var(--gutter);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-radius: var(--r-media);
    background: var(--linen);
    overflow: hidden;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(16rem, 2fr) repeat(3, 1fr);
    gap: 2.5rem clamp(1.5rem, 4vw, 4rem);
  }

  .about {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 24rem;
  }

  .name {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 0.75rem;
  }

  ul {
    display: grid;
    gap: 0.5rem;
  }

  li a {
    text-decoration: none;
  }

  li a:hover {
    text-decoration: underline;
  }

  li span {
    display: block;
    font-size: var(--text-small);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--stone);
    font-size: var(--text-small);
    color: var(--ink-soft);
  }

  .legal ul {
    display: flex;
    gap: 1.5rem;
  }

  /* Le nom en très grand, coupé par le bas du bloc, comme une signature. */
  .wordmark {
    margin-top: clamp(1.5rem, 3vw, 3rem);
    margin-bottom: -0.21em;
    padding-inline: var(--pad);
    font-size: clamp(3rem, 16.5vw, 19rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    color: var(--stone);
    user-select: none;
  }

  @media (max-width: 56rem) {
    .columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .about,
    .columns > :last-child {
      grid-column: 1 / -1;
    }
  }
</style>
