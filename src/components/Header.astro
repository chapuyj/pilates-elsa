---
import { site } from '../config/site';
import { navigation, contactHref } from '../config/navigation';

interface Props {
  /** Sur l'accueil, la barre de navigation est posée sur la grande photo. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { overlay }]}>
  <div class="bar">
    <a class="brand" href="/">{site.name}</a>

    <nav class="links" aria-label="Navigation principale">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="btn btn--ink contact" href={contactHref}>Contact</a>
    <button class="btn btn--ink menu-button" type="button" popovertarget="menu">Menu</button>
  </div>

  <div class="menu" id="menu" popover>
    <div class="menu-top">
      <a class="brand" href="/">{site.name}</a>
      <button class="btn btn--line" type="button" popovertarget="menu" popovertargetaction="hide">Fermer</button>
    </div>
    <nav aria-label="Menu">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="btn btn--ink" href={contactHref}>Écrire à Elsa</a>
  </div>
</header>

<style>
  .site-header {
    padding: var(--gutter) var(--gutter) 0;
  }

  .site-header.overlay {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
    padding: calc(var(--gutter) + 0.75rem) calc(var(--gutter) + 0.75rem) 0;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    min-height: 3.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1.5rem;
    border-radius: 999px;
    background: var(--linen);
  }

  /* Sur la photo : une barre translucide, pour que le menu reste lisible quelle que soit l'image. */
  .overlay .bar {
    background: rgb(255 255 255 / 0.8);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
  }

  .brand {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    justify-self: start;
  }

  .links {
    display: flex;
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }

  .links a {
    font-size: 1rem;
    text-decoration: none;
    padding-block: 0.5rem;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 85% / 0 1px;
    transition: background-size 0.35s var(--ease-out);
  }

  .links a:hover {
    background-size: 100% 1px;
  }

  .contact,
  .menu-button {
    justify-self: end;
  }

  .menu-button {
    display: none;
  }

  /* Le menu mobile : une feuille plein écran, ouverte sans JavaScript. */
  .menu {
    position: fixed;
    inset: var(--gutter);
    width: auto;
    height: auto;
    margin: 0;
    padding: 1rem 1rem 1.25rem 1.5rem;
    border: 0;
    border-radius: var(--r-media);
    background: var(--linen);
    color: var(--ink);
    overflow: auto;
  }

  .menu:popover-open {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .menu::backdrop {
    background: rgb(38 33 28 / 0.6);
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu nav {
    display: grid;
    gap: 0.25rem;
    margin-block: auto;
  }

  .menu nav a {
    font-size: clamp(2rem, 9vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.25;
    text-decoration: none;
  }

  .menu > .btn {
    justify-content: center;
    padding-block: 1.15rem;
  }

  @media (max-width: 56rem) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-left: 1.25rem;
    }

    .links,
    .contact {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }
  }
</style>
