---
// Grille de vignettes photo : une par offre.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';

interface Props {
  offres: CollectionEntry<'offres'>[];
}
const { offres } = Astro.props;
const colonnes = Math.min(offres.length, 4);
---

<ul class="offer-grid" role="list" style={`--colonnes: ${colonnes}`}>
  {
    offres.map((offre) => (
      <li>
        <a class="offer" href={`/${offre.id}/`}>
          <div class="offer-photo">
            <Image
              src={offre.data.photo}
              alt={offre.data.photoAlt}
              widths={[400, 640, 900]}
              sizes="(min-width: 70rem) 24vw, (min-width: 38rem) 48vw, 100vw"
            />
            <span class="offer-badge"><Arrow /></span>
          </div>
          <h3>{offre.data.titreCourt}</h3>
          <p class="muted">{offre.data.resume}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(var(--colonnes), 1fr);
    gap: 2.5rem clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .offer {
    display: block;
    text-decoration: none;
  }

  .offer-photo {
    position: relative;
    margin-bottom: 1.125rem;
    border-radius: var(--r-media);
    overflow: hidden;
    background: var(--linen);
  }

  .offer-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .offer:hover .offer-photo :global(img) {
    transform: scale(1.04);
  }

  .offer-badge {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition: transform 0.35s var(--ease-out);
  }

  .offer:hover .offer-badge {
    transform: translateX(3px);
  }

  h3 {
    margin-bottom: 0.375rem;
  }

  p {
    max-width: 34ch;
  }

  @media (max-width: 70rem) {
    .offer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .offer-grid {
      grid-template-columns: 1fr;
    }

    .offer-photo :global(img) {
      aspect-ratio: 3 / 2;
    }
  }
</style>
