---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config/site';
import { contactHref } from '../config/navigation';
import { offresPubliees } from '../lib/offres';
import { dansLOrdre } from '../lib/listes';
import photoAccueil from '../assets/photos/accueil-reformer.jpg';
import photoDifference from '../assets/photos/posture-reformer.jpg';

const offres = await offresPubliees();
const offreEnAvant = offres.find((offre) => offre.data.enAvant);
const autresOffres = offres.filter((offre) => offre !== offreEnAvant);
const nombres = ['', 'Une', 'Deux', 'Trois', 'Quatre', 'Cinq', 'Six'];
const titreOffres = `${nombres[offres.length] ?? 'Plusieurs'} façons de pratiquer`;

const lieux = dansLOrdre(await getCollection('lieux'));
const questions = dansLOrdre(await getCollection('faq')).slice(0, 4);

// Les trois raisons de choisir Elsa. À faire relire par Elsa.
const differences = [
  {
    titre: 'Une formation longue et complète',
    texte:
      "Elsa s'est formée au Pilates sur tapis puis sur machines chez Revolt, l'école des studios Reformation à Paris. Des mois de pratique encadrée, d'anatomie et de pédagogie, validés par des examens.",
  },
  {
    titre: 'Une attention portée à chacun',
    texte:
      'Chaque corps est différent. Elsa observe, corrige et adapte les exercices, y compris pendant et après une grossesse.',
  },
  {
    titre: "Le souffle d'abord",
    texte: "La respiration est la base du Pilates. C'est par elle que commence le travail en profondeur.",
  },
];
---

<Base
  title={`${site.name} : cours de Pilates à Joinville-le-Pont et Saint-Maur`}
  description="Cours de Pilates avec Elsa à Joinville-le-Pont et Saint-Maur-des-Fossés, à domicile, en visio et en entreprise. Formée sur tapis et sur machines chez Revolt."
  overlay
>
  <section class="hero on-dark">
    <Image
      class="hero-photo"
      src={photoAccueil}
      alt="Une femme en appui sur un Reformer, dans un studio de Pilates aux tons clairs."
      widths={[640, 960, 1280, 1680, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-body">
      <h1>
        Le Pilates, à votre rythme.
        <span>Cours à Joinville-le-Pont et Saint-Maur-des-Fossés, à domicile, en visio et en entreprise.</span>
      </h1>
      <div class="hero-actions">
        <a class="btn btn--paper" href={contactHref}>Écrire à Elsa <Arrow /></a>
        <a class="arrow-link" href="#cours">Voir les cours</a>
      </div>
    </div>
  </section>

  <section class="section statement">
    <div class="wrap">
      <p>Un Pilates précis et attentif, qui part de la respiration et s'adapte à chaque corps.</p>
      <a class="btn btn--ink" href="/a-propos/">Qui est Elsa <Arrow /></a>
    </div>
  </section>

  <section class="offers" id="cours">
    <div class="wrap">
      <div class="section-head">
        <h2>{titreOffres}</h2>
        <p class="lead muted">
          Seul, à deux, en petit groupe ou avec vos équipes : la méthode est la même, le cadre s'adapte à votre vie.
        </p>
      </div>

      {
        offreEnAvant && (
          <a class="offer offer--featured" href={`/${offreEnAvant.id}/`}>
            <Image src={offreEnAvant.data.photo} alt={offreEnAvant.data.photoAlt} widths={[640, 960, 1400]} sizes="(min-width: 56rem) 58vw, 100vw" />
            <div>
              <h3>{offreEnAvant.data.titreCourt}</h3>
              <p class="lead muted">{offreEnAvant.data.resume}</p>
              <span class="arrow-link">Découvrir le cours <Arrow /></span>
            </div>
          </a>
        )
      }

      <ul class="offer-grid" role="list">
        {
          autresOffres.map((offre) => (
            <li>
              <a class="offer" href={`/${offre.id}/`}>
                <div class="offer-photo">
                  <Image src={offre.data.photo} alt={offre.data.photoAlt} widths={[400, 640, 900]} sizes="(min-width: 70rem) 24vw, (min-width: 38rem) 48vw, 100vw" />
                  <span class="offer-badge"><Arrow /></span>
                </div>
                <h3>{offre.data.titreCourt}</h3>
                <p class="muted">{offre.data.resume}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section difference">
    <div class="wrap">
      <Image
        class="difference-photo"
        src={photoDifference}
        alt="Une femme allongée sur un Reformer, jambes tendues vers le plafond, pieds dans les sangles."
        widths={[480, 800, 1200]}
        sizes="(min-width: 56rem) 40vw, 100vw"
      />
      <div class="difference-text">
        <h2>Ce qui fait la différence</h2>
        <ul role="list">
          {
            differences.map((item) => (
              <li>
                <h3>{item.titre}</h3>
                <p class="muted">{item.texte}</p>
              </li>
            ))
          }
        </ul>
        <a class="arrow-link" href="/a-propos/">Le parcours d'Elsa <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="studios">
    <div class="wrap">
      <div class="section-head">
        <h2>Deux studios dans le Val-de-Marne</h2>
        <p class="lead muted">
          Elsa y enseigne le Pilates sur Reformer, en petit groupe. La réservation se fait auprès de chaque studio.
        </p>
      </div>
      <ul class="studio-list" role="list">
        {
          lieux.map((lieu) => (
            <li>
              <h3>{lieu.data.nom}</h3>
              <p class="muted">
                {lieu.data.adresse}, {lieu.data.codePostal} {lieu.data.ville}
              </p>
              <a class="arrow-link" href={lieu.data.planning} rel="noopener">
                Voir le planning <Arrow out />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section faq">
    <div class="wrap">
      <div class="faq-head">
        <h2>Questions fréquentes</h2>
        <a class="arrow-link" href="/faq/">Toutes les questions <Arrow /></a>
      </div>
      <div class="faq-list">
        {
          questions.map((item) => (
            <details>
              <summary>
                <h3>{item.data.question}</h3>
                <span class="faq-mark" aria-hidden="true" />
              </summary>
              <p class="muted">{item.data.reponse}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing on-dark">
    <h2>Parlons de votre pratique.</h2>
    <p class="lead">
      Vos envies, vos disponibilités, vos éventuelles douleurs : écrivez quelques lignes, Elsa vous répond.
    </p>
    <a class="btn btn--paper" href={contactHref}>Écrire à Elsa <Arrow /></a>
  </section>
</Base>

<style>
  /* Grande photo d'ouverture */

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(34rem, 80svh, 52rem);
    margin: var(--gutter);
    border-radius: var(--r-media);
    overflow: hidden;
    background: #5b4c3f;
    color: var(--on-ink);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 52%;
  }

  /* Voile sombre en bas à gauche, pour que le titre reste lisible sur la photo. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(30 23 17 / 0.62) 0%, rgb(30 23 17 / 0) 55%),
      linear-gradient(75deg, rgb(30 23 17 / 0.72) 0%, rgb(30 23 17 / 0.38) 38%, rgb(30 23 17 / 0) 66%);
  }

  .hero-body {
    padding: 8rem clamp(1.25rem, 2.6vw, 2.5rem) clamp(1.5rem, 3vw, 3rem);
  }

  h1 {
    max-width: 14ch;
    font-size: var(--title-1);
    line-height: 1;
  }

  h1 span {
    display: block;
    max-width: 36ch;
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    line-height: 1.5;
    letter-spacing: 0;
    text-wrap: pretty;
    color: #f3ece4;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  /* Phrase d'intention */

  .statement .wrap {
    display: grid;
    justify-items: center;
    gap: 2.25rem;
    text-align: center;
  }

  .statement p {
    max-width: 24ch;
    font-size: var(--statement);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* En-tête de section : titre à gauche, phrase à droite */

  .section-head {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: end;
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .section-head p {
    max-width: 44ch;
    justify-self: end;
  }

  /* Les offres */

  .offer {
    display: block;
    text-decoration: none;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .offer-photo {
    position: relative;
    margin-bottom: 1.125rem;
    border-radius: var(--r-media);
    overflow: hidden;
    background: var(--linen);
  }

  .offer-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .offer:hover .offer-photo :global(img) {
    transform: scale(1.04);
  }

  .offer-badge {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition: transform 0.35s var(--ease-out);
  }

  .offer:hover .offer-badge {
    transform: translateX(3px);
  }

  .offer h3 {
    margin-bottom: 0.375rem;
  }

  .offer p {
    max-width: 34ch;
  }

  .offer--featured {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--r-media);
    background: var(--linen);
    overflow: hidden;
  }

  .offer--featured :global(img) {
    width: 100%;
    height: 100%;
    max-height: 34rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .offer--featured div {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: 2rem clamp(1.5rem, 3vw, 3rem) 2rem 0;
  }

  .offer--featured h3 {
    font-size: var(--title-2);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }

  /* Ce qui fait la différence */

  .difference .wrap {
    display: grid;
    grid-template-columns: 5fr 6fr;
    align-items: center;
    gap: 2.5rem clamp(2rem, 7vw, 7rem);
  }

  .difference-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-media);
    object-fit: cover;
  }

  .difference-text {
    display: grid;
    justify-items: start;
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }

  .difference-text ul {
    width: 100%;
  }

  .difference-text li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--stone);
  }

  .difference-text li:last-child {
    border-bottom: 1px solid var(--stone);
  }

  .difference-text li p {
    max-width: 58ch;
  }

  /* Les studios */

  .studios {
    margin-inline: var(--gutter);
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-radius: var(--r-media);
    background: var(--linen);
  }

  .studio-list li {
    display: grid;
    grid-template-columns: 1.1fr 1fr auto;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--stone);
  }

  .studio-list li:last-child {
    padding-bottom: 0;
  }

  .studio-list h3 {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  /* Questions fréquentes */

  .faq .wrap {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: start;
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
  }

  .faq-head {
    display: grid;
    justify-items: start;
    gap: 1.75rem;
  }

  details {
    border-top: 1px solid var(--stone);
  }

  details:last-child {
    border-bottom: 1px solid var(--stone);
  }

  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.375rem;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-weight: 400;
  }

  /* Le signe plus, qui devient moins quand la réponse est ouverte. */
  .faq-mark {
    position: relative;
    width: 1rem;
    height: 1rem;
  }

  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }

  .faq-mark::after {
    transform: rotate(90deg);
  }

  details[open] .faq-mark::after {
    transform: rotate(0deg);
  }

  details p {
    max-width: 62ch;
    padding-bottom: 1.5rem;
  }

  /* Invitation finale */

  .closing {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    margin: 0 var(--gutter);
    padding: clamp(4rem, 9vw, 8rem) var(--pad);
    border-radius: var(--r-media);
    background: var(--ink);
    color: var(--on-ink);
    text-align: center;
  }

  .closing h2 {
    font-size: var(--title-1);
    line-height: 1;
  }

  .closing p {
    max-width: 44ch;
    color: var(--on-ink-soft);
  }

  .closing .btn {
    margin-top: 0.75rem;
  }

  /* Écrans moyens et petits */

  @media (max-width: 70rem) {
    .offer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 56rem) {
    .hero-body {
      padding-top: 7rem;
    }

    .section-head,
    .difference .wrap,
    .faq .wrap,
    .offer--featured {
      grid-template-columns: 1fr;
    }

    .section-head p {
      justify-self: start;
    }

    .offer--featured div {
      padding: 0 1.5rem 2rem;
    }

    .difference-photo {
      aspect-ratio: 4 / 3;
      object-position: 50% 70%;
    }

    .studio-list li {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }

  @media (max-width: 38rem) {
    .hero {
      min-height: 86svh;
    }

    .hero-photo {
      object-position: 30% 50%;
    }

    .offer-grid {
      grid-template-columns: 1fr;
    }

    .offer-photo :global(img) {
      aspect-ratio: 3 / 2;
    }
  }
</style>
