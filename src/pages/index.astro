---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import OfferGrid from '../components/OfferGrid.astro';
import StudioList from '../components/StudioList.astro';
import FaqList from '../components/FaqList.astro';
import Closing from '../components/Closing.astro';
import PhotoNote from '../components/PhotoNote.astro';
import { site } from '../config/site';
import { contactHref } from '../config/navigation';
import { offresPubliees } from '../lib/offres';
import { dansLOrdre } from '../lib/listes';
import { donneesActivite } from '../lib/jsonld';
import photoAccueil from '../assets/photos/accueil-reformer.jpg';
import photoAccueilMobile from '../assets/photos/accueil-reformer-mobile.jpg';
import photoDifference from '../assets/photos/posture-reformer.jpg';

const offres = await offresPubliees();
const offreEnAvant = offres.find((offre) => offre.data.enAvant);
const autresOffres = offres.filter((offre) => offre !== offreEnAvant);
const nombres = ['', 'Une', 'Deux', 'Trois', 'Quatre', 'Cinq', 'Six'];
const titreOffres = `${nombres[offres.length] ?? 'Plusieurs'} façons de pratiquer`;

const questions = dansLOrdre(await getCollection('faq')).slice(0, 4);

// Sur mobile, la grande photo est remplacée par une version verticale, mieux cadrée pour un écran étroit.
const accueilMobile = await getImage({ src: photoAccueilMobile, widths: [480, 780, 1170], format: 'webp' });

// Les trois raisons de choisir Elsa. À faire relire par Elsa.
const differences = [
  {
    titre: 'Une formation longue et complète',
    texte:
      "Elsa s'est formée au Pilates sur tapis puis sur machines chez Revolt, l'école des studios Reformation à Paris. Des mois de pratique encadrée, d'anatomie et de pédagogie, validés par des examens.",
  },
  {
    titre: 'Une attention portée à chacun',
    texte:
      'Chaque corps est différent. Elsa observe, corrige et adapte les exercices, y compris pendant et après une grossesse.',
  },
  {
    titre: "Le souffle d'abord",
    texte: "La respiration est la base du Pilates. C'est par elle que commence le travail en profondeur.",
  },
];
---

<Base
  title={`${site.name} : cours de Pilates à Joinville-le-Pont et Saint-Maur`}
  description="Cours de Pilates avec Elsa à Joinville-le-Pont et Saint-Maur-des-Fossés, à domicile, en visio et en entreprise. Formée sur tapis et sur machines chez Revolt."
  jsonLd={donneesActivite()}
  overlay
>
  <section class="hero on-dark">
    <picture>
      <source media="(max-width: 38rem)" srcset={accueilMobile.srcSet.attribute} sizes="100vw" type="image/webp" />
      <Image
        class="hero-photo"
        src={photoAccueil}
        alt="Une femme en plein exercice sur un Reformer, dans un studio de Pilates lumineux aux tons clairs."
        widths={[640, 960, 1280, 1680, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-note"><PhotoNote /></div>
    <div class="hero-body">
      <h1>
        Le Pilates, à votre rythme.
        <span>Cours à Joinville-le-Pont et Saint-Maur-des-Fossés, à domicile, en visio et en entreprise.</span>
      </h1>
      <div class="hero-actions">
        <a class="btn btn--paper" href={contactHref}>Écrire à Elsa <Arrow /></a>
        <a class="arrow-link" href="#cours">Voir les cours <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section statement">
    <div class="wrap">
      <p>Un Pilates précis et attentif, qui part de la respiration et s'adapte à chaque corps.</p>
      <a class="btn btn--ink" href="/a-propos/">Qui est Elsa <Arrow /></a>
    </div>
  </section>

  <section id="cours">
    <div class="wrap">
      <div class="section-head">
        <h2>{titreOffres}</h2>
        <p class="lead muted">
          Seul, à deux, en petit groupe ou avec vos équipes : la méthode est la même, le cadre s'adapte à votre vie.
        </p>
      </div>

      {
        offreEnAvant && (
          <a class="featured" href={`/${offreEnAvant.id}/`}>
            <Image
              src={offreEnAvant.data.photo}
              alt={offreEnAvant.data.photoAlt}
              widths={[640, 960, 1400]}
              sizes="(min-width: 56rem) 58vw, 100vw"
              style={`object-position: ${offreEnAvant.data.photoCadrage}`}
            />
            <div>
              <h3>{offreEnAvant.data.titreCourt}</h3>
              <p class="lead muted">{offreEnAvant.data.resume}</p>
              <span class="arrow-link">Découvrir le cours <Arrow /></span>
            </div>
          </a>
        )
      }

      <OfferGrid offres={autresOffres} />
    </div>
  </section>

  <section class="section difference">
    <div class="wrap">
      <div class="difference-photo">
        <PhotoNote />
        <Image
          src={photoDifference}
          alt="Une femme allongée sur un Reformer, jambes tendues vers le plafond, pieds dans les sangles."
          widths={[480, 800, 1200]}
          sizes="(min-width: 56rem) 40vw, 100vw"
        />
      </div>
      <div class="difference-text">
        <h2>Ce qui fait la différence</h2>
        <ul class="rows">
          {
            differences.map((item) => (
              <li>
                <h3>{item.titre}</h3>
                <p class="muted">{item.texte}</p>
              </li>
            ))
          }
        </ul>
        <a class="arrow-link" href="/a-propos/">Le parcours d'Elsa <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="wrap">
      <div class="section-head">
        <h2>Deux studios dans le Val-de-Marne</h2>
        <p class="lead muted">
          Elsa y enseigne le Pilates sur Reformer, en petit groupe. La réservation se fait auprès de chaque studio.
        </p>
      </div>
      <StudioList />
    </div>
  </section>

  <section class="section faq">
    <div class="wrap">
      <div class="faq-head">
        <h2>Questions fréquentes</h2>
        <a class="arrow-link" href="/faq/">Toutes les questions <Arrow /></a>
      </div>
      <FaqList questions={questions} />
    </div>
  </section>

  <Closing />
</Base>

<style>
  /* Grande photo d'ouverture */

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(34rem, 80svh, 52rem);
    margin: var(--gutter);
    border-radius: var(--r-media);
    overflow: hidden;
    background: var(--ink-hover);
    color: var(--on-ink);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 52%;
  }

  /* À l'ouverture de la page, la photo se pose doucement. Sans mouvement, elle est simplement là. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo {
      animation: poser 1.6s var(--ease-out) backwards;
    }
  }

  @keyframes poser {
    from {
      transform: scale(1.045);
    }
    to {
      transform: scale(1);
    }
  }

  /* Voile sombre limité au coin du texte, pour que le reste de la photo garde sa lumière. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 78% 112% at 0% 100%,
      rgb(30 23 17 / 0.74) 0%,
      rgb(30 23 17 / 0.52) 38%,
      rgb(30 23 17 / 0) 100%
    );
  }

  /* Le repère « photo provisoire » se place en bas à droite, loin du menu et du titre. */
  .hero-note :global(.photo-note) {
    inset: auto 1rem 1rem auto;
  }

  .hero-body {
    padding: 8rem clamp(1.25rem, 2.6vw, 2.5rem) clamp(1.5rem, 3vw, 3rem);
  }

  h1 {
    max-width: 14ch;
    font-size: var(--title-1);
    line-height: 1;
    text-shadow: 0 1px 28px rgb(30 23 17 / 0.4);
  }

  h1 span {
    display: block;
    max-width: 36ch;
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    line-height: 1.5;
    letter-spacing: 0;
    text-wrap: pretty;
    color: #f3ece4;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  /* Phrase d'intention */

  .statement .wrap {
    display: grid;
    justify-items: center;
    gap: 2.25rem;
    text-align: center;
  }

  .statement p {
    max-width: 24ch;
    font-size: var(--statement);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* L'offre mise en avant, en grand au-dessus des autres */

  .featured {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--r-media);
    background: var(--linen);
    overflow: hidden;
    text-decoration: none;
  }

  .featured :global(img) {
    width: 100%;
    height: 100%;
    max-height: 34rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .featured div {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: 2rem clamp(1.5rem, 3vw, 3rem) 2rem 0;
  }

  .featured h3 {
    font-size: var(--title-2);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }

  /* Ce qui fait la différence */

  .difference .wrap {
    display: grid;
    grid-template-columns: 5fr 6fr;
    align-items: center;
    gap: 2.5rem clamp(2rem, 7vw, 7rem);
  }

  .difference-photo {
    position: relative;
    border-radius: var(--r-media);
    overflow: hidden;
  }

  .difference-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .difference-text {
    display: grid;
    justify-items: start;
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }

  .difference-text ul {
    width: 100%;
  }

  .difference-text li {
    display: grid;
    gap: 0.5rem;
  }

  .difference-text li p {
    max-width: 58ch;
  }

  /* Questions fréquentes */

  .faq .wrap {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: start;
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
  }

  .faq-head {
    display: grid;
    justify-items: start;
    gap: 1.75rem;
  }

  /* Écrans moyens et petits */

  @media (max-width: 56rem) {
    .hero-body {
      padding-top: 7rem;
    }

    .difference .wrap,
    .faq .wrap,
    .featured {
      grid-template-columns: 1fr;
    }

    .featured div {
      padding: 0 1.5rem 2rem;
    }

    .difference-photo :global(img) {
      aspect-ratio: 4 / 3;
      object-position: 50% 70%;
    }
  }

  /* Sur mobile, la photo (version verticale) garde toute sa lumière : le texte passe dessous, sur fond blanc. */
  @media (max-width: 38rem) {
    .hero {
      display: block;
      min-height: 0;
      border-radius: 0;
      overflow: visible;
      background: none;
      color: var(--ink);
    }

    .hero::before {
      display: none;
    }

    .hero-photo {
      position: static;
      height: 60svh;
      min-height: 22rem;
      border-radius: var(--r-media);
      object-position: 62% 45%;
    }

    .hero-body {
      padding: 1.75rem calc(var(--pad) - var(--gutter)) 0.5rem;
    }

    h1 {
      text-shadow: none;
    }

    h1 span {
      color: var(--ink-soft);
    }

    .hero .btn--paper {
      background: var(--ink);
      color: var(--on-ink);
    }

    .hero :global(:focus-visible) {
      outline-color: var(--ink);
    }

    .hero-note :global(.photo-note) {
      inset: 5.5rem auto auto 1rem;
    }
  }
</style>
