---
// Politique de confidentialité. À relire à la mise en ligne : elle doit décrire ce que le site fait réellement.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../config/site';

const { editeur } = site.legal;
const { email } = site.contact;
---

<Base title={`Confidentialité | ${site.name}`} description={`Ce que le site ${site.name} fait de vos données personnelles.`}>
  <PageHead titre="Confidentialité" intro="Ce site collecte le moins de données possible. Voici lesquelles, et pourquoi." />

  <section class="legal">
    <div class="wrap">
      <div class="prose">
        <h2>Quand vous écrivez à Elsa</h2>
        <p>
          Le formulaire de contact demande votre nom, votre adresse e-mail et votre message. Ces informations servent
          uniquement à vous répondre et à organiser vos cours. Elles ne sont ni vendues ni transmises à des tiers.
        </p>
        <p>
          Elles sont conservées le temps de l'échange, puis au plus trois ans après le dernier contact. Vous pouvez
          demander leur suppression à tout moment.
        </p>

        <h2>Cookies et mesure d'audience</h2>
        <p>Ce site ne dépose aucun cookie publicitaire ou de suivi, et n'affiche donc pas de bandeau de consentement.</p>

        <h2>Hébergement</h2>
        <p>
          Le site est hébergé par Cloudflare. Comme tout hébergeur, Cloudflare traite des données techniques
          (adresse IP, type de navigateur) pour acheminer les pages et protéger le site.
        </p>

        <h2>Réservations en studio</h2>
        <p>
          Les cours en studio se réservent sur les sites des studios. Vos données y sont alors traitées par ces
          studios, selon leurs propres règles.
        </p>

        <h2>Vos droits</h2>
        <p>
          Vous pouvez demander à consulter, corriger ou supprimer les données qui vous concernent. Le responsable du
          traitement est {editeur ?? <span class="a-completer">nom à compléter</span>}. Pour exercer vos droits,
          {email ? <a href={`mailto:${email}`}>écrivez à {email}</a> : <a href="/contact/">utilisez la page de contact</a>}.
          Si la réponse ne vous satisfait pas, vous pouvez saisir la CNIL (<a href="https://www.cnil.fr" rel="noopener">cnil.fr</a>).
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .legal {
    padding-bottom: var(--section);
  }
</style>
